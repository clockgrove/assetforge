{
  "name": "@clockgrove/assetforge",
  "version": "0.0.0",
  "description": "Generates game assets through generation models and hands them to a game's own asset pipeline with full provenance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/assetforge.git"
  },
  "type": "module",
  "bin": {
    "assetforge": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assetforge": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "prettier --check . && eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "prepack": "pnpm build",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:real": "node --test \"test/real/**/*.real.ts\""
  },
  "dependencies": {
    "ai": "7.0.165",
    "gltf-validator": "2.0.0-dev.3.10",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "eslint": "10.14.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
